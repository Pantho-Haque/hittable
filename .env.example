# Copy to .env (or set in your host's dashboard). Every value is optional;
# the defaults are what the hosted app runs with.

# /api/proxy refuses loopback, private and link-local addresses (cloud metadata
# included), so a public instance cannot be used to reach its own network.
# Set to true only on a self-hosted instance that should reach internal APIs.
PROXY_ALLOW_PRIVATE_NETWORKS=false

# Requests per minute per client IP, per server instance. 0 turns it off.
# For a hard global limit, add a rate-limit rule in front (e.g. Vercel Firewall).
PROXY_RATE_LIMIT_PER_MINUTE=120

# Give up on an upstream that has not answered after this long.
PROXY_TIMEOUT_MS=30000

# Largest response body the proxy will relay, after decompression. Vercel caps
# a function response at 4.5 MB, so keep this under that there.
PROXY_MAX_RESPONSE_BYTES=4194304

# Largest request (url + headers + body) the proxy accepts.
PROXY_MAX_REQUEST_BYTES=4194304

# --- Sign in with GitHub (required for the GitHub workspace) ---
# Create an OAuth App: GitHub → Settings → Developer settings → OAuth Apps → New.
#   Homepage URL:               https://<host>
#   Authorization callback URL: https://<host>/api/github/callback
#   (for local dev, a second app with http://localhost:3000/api/github/callback)
# Optionally tick "Enable token expiration": tokens then expire after 8 hours and
# the server refreshes them with the refresh token. Without it they do not expire.
# Sign-in answers 500 {error:"config"} until all three are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Encrypts the session cookie (AES-256-GCM). At least 32 bytes; e.g.
#   openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=

# Public origin, used for the OAuth redirect_uri and the post-login redirect.
# Set it when the app runs behind a proxy that rewrites Host; otherwise the
# request's own origin is used. Must be the host users actually visit.
# APP_URL=https://hittable.example.com

# GitHub endpoints. Override only for GitHub Enterprise Server or tests.
# GITHUB_API_URL=https://api.github.com
# GITHUB_OAUTH_URL=https://github.com
# GITHUB_GRAPHQL_URL=https://api.github.com/graphql   (defaults to $GITHUB_API_URL/graphql)
